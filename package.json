{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate",
    "clean": "hexo clean",
    "predeploy": "test -z \"$(git status --porcelain)\" || { echo 'ERROR: source 有未 commit 的變更，請先 commit 再部署'; exit 1; }; git fetch -q && git merge-base --is-ancestor HEAD @{u} || { echo 'ERROR: source 有未 push 的 commit，請先 git push 再部署'; exit 1; }",
    "deploy": "hexo clean && hexo deploy -g -m \"Deploy $(git rev-parse --short HEAD): $(git log -1 --pretty=%s)\"",
    "server": "hexo server"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "^8.1.2",
    "hexo-deployer-git": "^4.0.0",
    "hexo-filter-mermaid-diagrams": "^1.0.5",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-markdown-it": "^7.1.1",
    "hexo-renderer-stylus": "^3.0.0",
    "hexo-server": "^3.0.0",
    "markdown-it-checkbox": "^1.1.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0"
  }
}